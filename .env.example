# Copy to .env for local docker-compose use. On Render, set these as
# real environment variables in the dashboard instead (see render.yaml).

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Leave unset to use local SQLite (./medmon.db). Set for Postgres:
DATABASE_URL=postgresql://medmon:medmon@localhost:5432/medmon

# Comma-separated list, or "*" for any origin
CORS_ORIGINS=*
